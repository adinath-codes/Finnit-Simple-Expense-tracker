# Public Expo configuration. Values prefixed with EXPO_PUBLIC_ are embedded in
# the app bundle, so never place provider secrets in this file.
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_FINN_ANONYMOUS_AUTH=false

# Debug builds use RevenueCat Test Store. Release builds ignore this key and
# require the matching Apple or Google public SDK key.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_your-test-store-public-key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-key
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=your-revenuecat-web-public-key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=finn_it_pro
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default

# Server-only RevenueCat credentials belong in Supabase secrets, never here.

# Optional production observability and analytics configuration.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
EXPO_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
EXPO_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_DISABLE_AUTO_UPLOAD=true
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-public-project-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLED=false
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY_SAMPLE_RATE=0
